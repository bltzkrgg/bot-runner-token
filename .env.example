DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_ALERT_WEBHOOK_URL=
# Optional restriction for CA scans. Empty = all accessible channels/DMs.
# Message Content intent must be enabled in Discord Developer Portal.
DISCORD_SCAN_CHANNEL_IDS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Numeric Telegram user IDs allowed to change shared config, comma-separated.
TELEGRAM_ADMIN_USER_IDS=
USER_HASH_SECRET=
DATABASE_URL=
GMGN_MODE=mock
CACHE_TOKEN_TTL_SECONDS=120
CACHE_HOLDER_TTL_SECONDS=180
CACHE_DEVELOPER_TTL_SECONDS=21600
MIN_COHORT_SIZE=300
MIN_OUTCOME_SAMPLE=100
NEIGHBOR_COUNT=100
LOG_LEVEL=info

# Optional GMGN-compatible JSON endpoints. Each endpoint should return either an
# array of token objects or an object containing tokens/items/data/list.
GMGN_SOLANA_URL=
GMGN_ROBINHOOD_URL=
GMGN_BSC_URL=

# Optional enriched JSON feeds with migration status and timed 5m volume history.
# If empty, spike scanners use the corresponding GMGN_*_URL above.
GMGN_SOLANA_SPIKE_URL=
GMGN_ROBINHOOD_SPIKE_URL=
GMGN_BSC_SPIKE_URL=

CONFIG_PATH=data/config.json
ALERT_CACHE_PATH=data/alert-cache.json
SPIKE_CACHE_PATH=data/spike-cache.json
